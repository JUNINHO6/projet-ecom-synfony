{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.users_today'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'admin.users_today'|trans }}</h1>

    {% if utilisateurs is empty %}
        <p>{{ 'admin.users_empty'|trans }}</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>{{ 'account.lastname'|trans }}</th>
                    <th>{{ 'account.firstname'|trans }}</th>
                    <th>{{ 'account.email'|trans }}</th>
                    <th>{{ 'admin.roles'|trans }}</th>
                    <th>{{ 'admin.registered_at'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for u in utilisateurs %}
                    <tr>
                        <td>{{ u.nom }}</td>
                        <td>{{ u.prenom }}</td>
                        <td>{{ u.email }}</td>
                        <td>{{ u.roles|join(', ') }}</td>
                        <td>{{ u.dateInscription|format_datetime('short', 'medium', locale=app.request.locale) }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
