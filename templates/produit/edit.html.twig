{% extends 'base.html.twig' %}

{% block title %}{{ 'product.edit'|trans }} — {{ produit.nom }}{% endblock %}

{% block body %}
    <h1>{{ 'product.edit'|trans }}</h1>
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit" class="btn">{{ 'product.save'|trans }}</button>
    {{ form_end(form) }}
    <p><a href="{{ path('app_produit_show', {id: produit.id}) }}">{{ 'product.back'|trans }}</a></p>
{% endblock %}
